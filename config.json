{
  "projectName": "Yoyaku",
  "language": "en",
  "template": "generic",
  "provider": "claude-cli",
  "categories": [
    {
      "id": "01-overview",
      "title": "Overview",
      "description": "Project mission, goals, scope"
    },
    {
      "id": "02-product",
      "title": "Product",
      "description": "Features, user flows, personas"
    },
    {
      "id": "03-architecture",
      "title": "Architecture",
      "description": "Technical design and system structure"
    },
    {
      "id": "04-design",
      "title": "Design",
      "description": "Visual and UX design system"
    },
    {
      "id": "05-operations",
      "title": "Operations",
      "description": "Deployment, monitoring, release process"
    },
    {
      "id": "06-history",
      "title": "History",
      "description": "Decisions, milestones, changelog"
    }
  ],
  "model": {
    "compile": "claude-sonnet-4-6",
    "lint": "claude-haiku-4-5-20251001",
    "query": "claude-sonnet-4-6",
    "explain": "claude-sonnet-4-6"
  },
  "ingestPaths": [
    { "from": "CLAUDE.md", "to": "raw/notes/" },
    { "from": "docs/*.md", "to": "raw/decisions/" },
    { "from": "docs/decisions/*.md", "to": "raw/decisions/" },
    { "from": "backend/src/lib/tools.ts", "to": "raw/code-snapshots/backend/" },
    { "from": "backend/src/lib/claude.ts", "to": "raw/code-snapshots/backend/" },
    { "from": "frontend/src/components/ChatInterface.tsx", "to": "raw/code-snapshots/frontend/" },
    { "from": "autocall/src/conversation.ts", "to": "raw/code-snapshots/autocall/" }
  ],
  "port": 8788,
  "watch": {
    "debounceMs": 30000,
    "autoCompile": true
  },
  "graph3d": {
    "preset": "tokyo-night",
    "worldLabel": "Districts",
    "nodeLabel": "Spots",
    "background": "#0a0612",
    "accentColor": "#ff6b9d",
    "particleColor": "#4fc3f7",
    "glowIntensity": 0.45,
    "starfield": true,
    "mode": "files",
    "sourceRoot": "./",
    "include": [
      "backend/src/**/*.ts",
      "frontend/src/**/*.tsx",
      "frontend/src/**/*.ts",
      "autocall/src/**/*.ts",
      "scraper/src/**/*.ts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/*.d.ts"
    ]
  },
  "sources": [
    {
      "path": "raw/notes",
      "type": "markdown",
      "glob": "**/*.md"
    },
    {
      "path": "raw/decisions",
      "type": "markdown",
      "glob": "**/*.md"
    },
    {
      "path": "raw/references",
      "type": "markdown",
      "glob": "**/*.md"
    },
    {
      "path": "raw/meetings",
      "type": "markdown",
      "glob": "**/*.md"
    },
    {
      "path": "raw/code-snapshots",
      "type": "text",
      "glob": "**/*"
    }
  ]
}