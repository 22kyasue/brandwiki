{
  "name": "brandwiki-engine",
  "version": "0.2.0",
  "description": "LLM-powered brand wiki compiler. Ingest raw notes, compile a living Markdown knowledge base, serve it as a Wikipedia-style web UI with interactive backlink graph.",
  "type": "module",
  "license": "MIT",
  "author": "22kyasue",
  "repository": {
    "type": "git",
    "url": "https://github.com/22kyasue/brandwiki.git"
  },
  "homepage": "https://github.com/22kyasue/brandwiki#readme",
  "bugs": {
    "url": "https://github.com/22kyasue/brandwiki/issues"
  },
  "keywords": [
    "wiki",
    "knowledge-base",
    "llm",
    "claude",
    "anthropic",
    "markdown",
    "karpathy",
    "brand",
    "cli",
    "documentation"
  ],
  "bin": {
    "brandwiki": "./dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "templates/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.12",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
